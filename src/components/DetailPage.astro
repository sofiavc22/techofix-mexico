---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type {PageData} from '../data/site-data';
interface Props{data:PageData;kind:'service'|'area';canonical:string;}
const {data,kind,canonical}=Astro.props;
const wa='https://wa.me/525591069566?text=Hola%20Techofix%2C%20quiero%20una%20cotizaci%C3%B3n%20gratuita';
const schema={"@context":"https://schema.org","@graph":[{"@type":"Service",name:data.title,description:data.description,provider:{"@type":"RoofingContractor",name:"Techofix",telephone:"+52 55 9106 9566",areaServed:["Coacalco","Tultitlán","Cuautitlán","Cuautitlán Izcalli"]}},{"@type":"FAQPage",mainEntity:data.faqs.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))},{"@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Inicio",item:"https://techofixmexico.site/"},{"@type":"ListItem",position:2,name:kind==='service'?"Servicios":"Zonas"},{"@type":"ListItem",position:3,name:data.title}]}]};
---
<BaseLayout title={`${data.title} | Techofix`} description={data.description} canonical={canonical} schema={schema}>
  <main class="detailPage"><Header/><section class="detailHero"><div><p class="eyebrow"><span></span>{data.eyebrow}</p><h1>{data.title}</h1><p>{data.description}</p><a class="button" href={wa}>Solicitar cotización ↗</a></div><aside><span>Techofix</span><strong>16 años</strong><p>Reparando e instalando techos residenciales e industriales.</p></aside></section><div class="breadcrumbs"><a href="/">Inicio</a><span>→</span><span>{kind==='service'?'Servicios':'Zonas'}</span><span>→</span><b>{data.title}</b></div><section class="detailIntro section"><div><p class="sectionTag">Evaluación antes de intervenir</p><h2>Primero encontramos<br/><em>el problema real.</em></h2></div><p>{data.intro}</p></section><section class="problemSection section"><p class="sectionTag light">Lo que atendemos</p><h2>Soluciones para cada<br/>tipo de daño.</h2><div class="problemGrid">{data.problems.map((x,i)=><article><span>0{i+1}</span><h3>{x}</h3></article>)}</div></section><section class="detailProcess section"><div><p class="sectionTag">Proceso claro</p><h2>De la revisión<br/>a la solución.</h2></div><ol>{data.process.map((x,i)=><li><span>0{i+1}</span><div><h3>{x.title}</h3><p>{x.text}</p></div></li>)}</ol></section><section class="faqSection section"><p class="sectionTag">Preguntas frecuentes</p><h2>Antes de solicitar<br/>tu cotización.</h2><div class="faqList">{data.faqs.map(x=><details><summary>{x.q}<span>+</span></summary><p>{x.a}</p></details>)}</div></section><section class="related section"><p class="sectionTag">Explora Techofix</p><div class="relatedLinks"><a href="/servicios/reparacion-de-goteras-y-filtraciones/">Goteras y filtraciones ↗</a><a href="/servicios/mantenimiento-de-techos-industriales/">Techos industriales ↗</a><a href="/zonas/coacalco/">Servicio en Coacalco ↗</a><a href="/zonas/cuautitlan-izcalli/">Servicio en Cuautitlán Izcalli ↗</a></div></section><section class="cta"><p class="sectionTag light">Cotización gratuita</p><h2>¿Revisamos tu techo?</h2><div><a class="button buttonWhite" href={wa}>Escribir por WhatsApp ↗</a><a class="phone" href="tel:+525591069566">55 9106 9566</a></div></section><Footer/></main>
</BaseLayout>
