---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type {PageData} from '../data/site-data';
import {serviceDetails,locationDetails} from '../data/content-details';
interface Props{data:PageData;kind:'service'|'area';canonical:string;}
const {data,kind,canonical}=Astro.props;
const wa=`https://wa.me/525591069566?text=${encodeURIComponent(`Hola Techofix, quiero una cotización gratuita para ${data.title}`)}`;
const service=kind==='service'?serviceDetails[data.slug]:null;
const location=kind==='area'?locationDetails[data.slug]:null;
const allAreas=['Coacalco','Tultitlán','Zumpango','Tultepec','Cuautitlán','Cuautitlán Izcalli','Tlalnepantla'];
const extraFaqs=kind==='service'?[{q:'¿Qué información debo enviar para solicitar una cotización?',a:'Comparte la ubicación, tipo de inmueble, fotografías de la cubierta y del daño interior, además de indicar si existe una filtración activa. Con estos datos podemos orientar la primera conversación y coordinar la revisión.'},{q:'¿Qué formas de pago aceptan?',a:'Aceptamos efectivo, tarjeta y transferencia. Las condiciones, anticipos y etapas se especifican en la propuesta correspondiente.'}]:[{q:`¿Atienden hogares e industria en ${location?.name}?`,a:'Sí. Atendemos inmuebles residenciales, comerciales e industriales. El acceso, altura, reglas de seguridad y alcance se revisan antes de confirmar cada servicio.'},{q:'¿Pueden llegar el mismo día?',a:'Las emergencias se reciben las 24 horas. La posibilidad de visita el mismo día depende de ubicación, tránsito, clima, acceso seguro y disponibilidad; siempre confirmamos una ventana antes de trasladarnos.'}];
const faqs=[...data.faqs,...extraFaqs];
const schema={"@context":"https://schema.org","@graph":[{"@type":"Service",name:data.title,description:data.description,provider:{"@type":"RoofingContractor",name:"Techofix",telephone:"+52 55 9106 9566",areaServed:allAreas}},{"@type":"FAQPage",mainEntity:faqs.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))},{"@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Inicio",item:"https://techofixmexico.site/"},{"@type":"ListItem",position:2,name:kind==='service'?"Servicios":"Zonas",item:`https://techofixmexico.site/${kind==='service'?'servicios':'zonas'}/`},{"@type":"ListItem",position:3,name:data.title}]}]};
---
<BaseLayout title={`${data.title} | Techofix`} description={data.description} canonical={canonical} schema={schema}>
  <main class="detailPage">
    <Header/>
    <section class="detailHero"><div><p class="eyebrow"><span></span>{data.eyebrow}</p><h1>{data.title}</h1><p>{data.description}</p><a class="button" href={wa}>Solicitar cotización ↗</a></div><aside><span>Techofix</span><strong>16 años</strong><p>Servicio residencial e industrial. Emergencias las 24 horas.</p></aside></section>
    <div class="breadcrumbs"><a href="/">Inicio</a><span>→</span><a href={kind==='service'?'/servicios/':'/zonas/'}>{kind==='service'?'Servicios':'Zonas'}</a><span>→</span><b>{data.title}</b></div>
    {kind==='service' && service && <>
      <section class="detailIntro section"><div><p class="sectionTag">Evaluación antes de intervenir</p><h2>Primero encontramos<br/><em>el problema real.</em></h2></div><div class="richCopy"><p>{data.intro}</p>{service.diagnosis.map(p=><p>{p}</p>)}</div></section>
      <section class="includedSection section"><div class="sectionHead darkText"><div><p class="sectionTag">Qué incluye el servicio</p><h2>Alcance detallado.</h2></div><p>La cotización final define qué partidas necesita tu techo. No añadimos trabajos que no hayan sido explicados y autorizados.</p></div><div class="includedGrid">{service.included.map((item,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
      <section class="problemSection section"><p class="sectionTag light">Problemas que resolvemos</p><h2>Señales que no conviene ignorar.</h2><div class="problemGrid">{data.problems.map((x,i)=><article><span>0{i+1}</span><h3>{x}</h3><p>Revisamos su causa, extensión y relación con el resto de la cubierta antes de definir una solución.</p></article>)}</div></section>
      <section class="detailProcess section"><div><p class="sectionTag">Proceso paso a paso</p><h2>De la revisión<br/>a la solución.</h2><p class="supportCopy">Cada proyecto comienza con información básica y termina con una explicación del trabajo realizado. El proceso puede adaptarse por clima, altura, reglas de acceso o continuidad de operación.</p></div><ol>{data.process.map((x,i)=><li><span>0{i+1}</span><div><h3>{x.title}</h3><p>{x.text}</p></div></li>)}<li><span>04</span><div><h3>Entrega y recomendaciones</h3><p>Revisamos terminaciones visibles, explicamos cuidados y entregamos la garantía correspondiente por escrito.</p></div></li></ol></section>
      <section class="whySection section"><div><p class="sectionTag">Por qué elegir Techofix</p><h2>Experiencia sin explicaciones complicadas.</h2></div><div class="whyGrid"><article><b>16 años</b><p>Experiencia práctica en cubiertas residenciales, comerciales e industriales.</p></article><article><b>Diagnóstico</b><p>Buscamos el origen probable antes de recomendar materiales o reemplazos.</p></article><article><b>Claridad</b><p>Explicamos alcance, exclusiones, costos y garantía antes de comenzar.</p></article><article><b>24 horas</b><p>Recibimos reportes de emergencia todos los días y confirmamos disponibilidad.</p></article><article><b>Cobertura local</b><p>Trabajamos en siete municipios del norte y área metropolitana del Estado de México.</p></article><article><b>Pagos flexibles</b><p>Aceptamos efectivo, tarjeta y transferencia conforme a la propuesta.</p></article></div></section>
      <section class="emergencySection section"><div><p class="sectionTag light">Disponibilidad de emergencia</p><h2>Atención las 24 horas.</h2></div><div class="richCopy">{service.emergency.map(p=><p>{p}</p>)}<p>Para solicitar prioridad envía fotografías, ubicación y explica qué áreas están en riesgo. La recepción 24/7 no representa una promesa automática de llegada inmediata: confirmamos disponibilidad y horario de manera directa.</p><a class="button buttonWhite" href={wa}>Reportar una emergencia ↗</a></div></section>
      <section class="serviceAreasSection section"><div><p class="sectionTag">Área de servicio</p><h2>Especialistas cerca de tu inmueble.</h2></div><div class="richCopy"><p>Este servicio está disponible en {allAreas.join(', ')}. Atendemos casas, condominios, comercios, oficinas, talleres, bodegas y naves industriales.</p><p>Para organizar la visita solicitamos municipio, colonia, código postal y ubicación compartida. En instalaciones industriales también pedimos datos de acceso, altura aproximada y persona responsable de recibirnos.</p><div class="inlineLinks">{Object.entries(locationDetails).map(([slug,item])=><a href={`/zonas/${slug}/`}>{item.name} ↗</a>)}</div></div></section>
    </>}
    {kind==='area' && location && <>
      <section class="detailIntro section"><div><p class="sectionTag">Servicio local</p><h2>Techofix en<br/><em>{location.name}.</em></h2></div><div class="richCopy"><p>{data.intro}</p>{location.localProfile.map(p=><p>{p}</p>)}<p>La cotización inicial es gratuita dentro de nuestra cobertura. Antes de acudir confirmamos la dirección, el tipo de techo y la información necesaria para aprovechar mejor la revisión.</p></div></section>
      <section class="localServices section"><div class="sectionHead darkText"><div><p class="sectionTag">Servicios disponibles</p><h2>Hogares, comercios e industria.</h2></div><p>El sistema adecuado depende de la cubierta y no solamente del síntoma visible.</p></div><div class="includedGrid">{data.problems.map((x,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{x}</h3><p>Revisión, alcance explicado y propuesta adaptada al inmueble en {location.name}.</p></article>)}<article><span>05</span><h3>Reparación de losas</h3><p>Atención de fisuras, humedad, puntos críticos y preparación previa a impermeabilizar.</p></article><article><span>06</span><h3>Mantenimiento industrial</h3><p>Inspección de láminas, canalones, remates, domos, equipos y bajadas pluviales.</p></article></div></section>
      <section class="routeSection section"><div><p class="sectionTag light">Referencias y rutas</p><h2>Cómo coordinamos la llegada.</h2><p>Usamos referencias principales para planear la ruta, pero solicitamos ubicación compartida antes de salir. No publicamos instrucciones desde una dirección física porque Techofix trabaja como servicio móvil.</p></div><div><h3>Referencias principales</h3><ul>{location.landmarks.map(x=><li>{x}</li>)}</ul>{location.routes.map(p=><p>{p}</p>)}</div></section>
      <section class="weatherSection section"><div><p class="sectionTag">Retos climáticos locales</p><h2>Lluvia, sol y movimiento.</h2></div><div class="richCopy">{location.weather.map(p=><p>{p}</p>)}<p>Una revisión preventiva antes de la temporada de lluvias permite limpiar desagües, renovar sellos y localizar áreas vulnerables con mejores condiciones de trabajo. Después de una tormenta, conviene documentar manchas y escurrimientos antes de que se sequen.</p></div></section>
      <section class="neighborhoodSection section"><div><p class="sectionTag light">Cobertura dentro del municipio</p><h2>Colonias y sectores.</h2><p>Estas referencias ayudan a explicar nuestra cobertura, pero no son una lista limitativa. Si tu colonia no aparece, envíanos la ubicación para confirmarla.</p></div><div class="neighborhoodList">{location.neighborhoods.map((x,i)=><span><b>{String(i+1).padStart(2,'0')}</b>{x}</span>)}</div></section>
      <section class="employersSection section"><div><p class="sectionTag">Centros de trabajo que podemos atender</p><h2>Sin inventar clientes ni logotipos.</h2></div><div class="richCopy"><p>En {location.name} podemos atender {location.workAreas.join(', ')}. Esto describe los tipos de inmueble para los que tenemos servicio; no implica que empresas concretas sean clientes de Techofix.</p><p>Para centros de trabajo solicitamos requisitos de seguridad, horarios de acceso, responsable interno y restricciones de operación. Con esa información dividimos el mantenimiento por áreas y reducimos interferencias innecesarias.</p></div></section>
      <section class="responseSection section"><div><p class="sectionTag">Tiempos de respuesta</p><h2>Confirmación según zona y condiciones.</h2></div><div><div class="responseGrid"><article><b>Zona central</b><p>Confirmamos disponibilidad después de recibir ubicación, fotografías y tipo de inmueble.</p></article><article><b>Corredores industriales</b><p>La visita también depende de casetas, registro, inducción y autorización para subir a cubierta.</p></article><article><b>Colonias periféricas</b><p>Solicitamos ubicación compartida y referencia para calcular el traslado correctamente.</p></article><article><b>Emergencias</b><p>Se reciben 24/7 y se priorizan por riesgo; el horario se confirma antes de enviar personal.</p></article></div><p class="responseNote">No publicamos un número de minutos que el tránsito, la lluvia o un acceso restringido puedan volver falso. Damos una ventana realista para cada solicitud.</p></div></section>
      <section class="comparisonSection section"><div><p class="sectionTag light">Comparación local</p><h2>Qué revisar antes de contratar.</h2><p>En lugar de desacreditar proveedores de {location.name}, te recomendamos comparar propuestas con los mismos criterios.</p></div><div class="comparisonTable"><div><b>Criterio</b><b>Techofix</b><b>Pregunta para comparar</b></div><div><span>Diagnóstico</span><span>Revisión antes de recomendar</span><span>¿Explican el origen probable?</span></div><div><span>Alcance</span><span>Partidas y exclusiones claras</span><span>¿Qué incluye exactamente el precio?</span></div><div><span>Garantía</span><span>Condiciones por escrito</span><span>¿Qué cubre y por cuánto tiempo?</span></div><div><span>Emergencias</span><span>Recepción 24/7</span><span>¿Confirman horario y seguridad?</span></div><div><span>Pago</span><span>Efectivo, tarjeta y transferencia</span><span>¿Entregan condiciones antes de iniciar?</span></div></div></section>
      <section class="detailProcess section"><div><p class="sectionTag">Proceso en {location.name}</p><h2>De tu mensaje<br/>a la solución.</h2></div><ol>{data.process.map((x,i)=><li><span>0{i+1}</span><div><h3>{x.title}</h3><p>{x.text}</p></div></li>)}<li><span>04</span><div><h3>Recomendaciones y garantía</h3><p>Explicamos el trabajo realizado, mantenimiento y condiciones aplicables.</p></div></li></ol></section>
    </>}
    <section class="faqSection section"><p class="sectionTag">Preguntas frecuentes</p><h2>Antes de solicitar<br/>tu cotización.</h2><div class="faqList">{faqs.map(x=><details><summary>{x.q}<span>+</span></summary><p>{x.a}</p></details>)}</div></section>
    <section class="related section"><p class="sectionTag">Explora Techofix</p><div class="relatedLinks"><a href="/servicios/">Todos los servicios ↗</a><a href="/zonas/">Todas las zonas ↗</a><a href="/nosotros/">Conoce Techofix ↗</a><a href="/contacto/">Solicita una cotización ↗</a></div></section>
    <section class="cta"><p class="sectionTag light">Cotización gratuita</p><h2>¿Revisamos tu techo?</h2><div><a class="button buttonWhite" href={wa}>Escribir por WhatsApp ↗</a><a class="phone" href="tel:+525591069566">55 9106 9566</a></div></section>
    <Footer/>
  </main>
</BaseLayout>
