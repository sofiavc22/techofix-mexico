---
import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import {articles} from '../../data/blog-data';
import {BUSINESS_ID,SITE_URL} from '../../data/seo';
export function getStaticPaths(){return Object.entries(articles).map(([slug,article])=>({params:{slug},props:{article}}));}
const {article:a}=Astro.props;
const articleUrl=`${SITE_URL}/blog/${a.slug}/`;
const schema={"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":`${articleUrl}#article`,headline:a.title,description:a.excerpt,datePublished:a.dateISO??"2026-08-19",dateModified:a.modifiedISO??a.dateISO??"2026-08-20",inLanguage:"es-MX",author:{"@id":BUSINESS_ID},publisher:{"@id":BUSINESS_ID},image:`${SITE_URL}/og.webp`,mainEntityOfPage:articleUrl,citation:a.sources?.map(source=>source.url)??[]},{"@type":"FAQPage","@id":`${articleUrl}#faq`,mainEntity:a.faqs.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))},{"@type":"BreadcrumbList","@id":`${articleUrl}#breadcrumbs`,itemListElement:[{"@type":"ListItem",position:1,name:"Inicio",item:`${SITE_URL}/`},{"@type":"ListItem",position:2,name:"Blog",item:`${SITE_URL}/blog/`},{"@type":"ListItem",position:3,name:a.title,item:articleUrl}]}]};
---
<BaseLayout title={a.metaTitle??`${a.title} | Techofix`} description={a.excerpt} canonical={`/blog/${a.slug}/`} schema={schema}>
<main class="articlePage"><Header/><article><header class="articleHero"><a href="/blog/">← Todas las guías</a><p>{a.category} · {a.readTime} · {a.date}</p><h1>{a.title}</h1><span>{a.excerpt}</span></header><div class="articleContent"><p class="articleLead">{a.intro}</p>{a.sections.map(s=><section><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map(x=><li>{x}</li>)}</ul>}</section>)}{a.related&&<section class="articleRelated"><h2>Servicios relacionados</h2><ul>{a.related.map(item=><li><a href={item.url}>{item.label} ↗</a></li>)}</ul></section>}<section class="articleFaq"><h2>Preguntas frecuentes</h2>{a.faqs.map(f=><div><h3>{f.q}</h3><p>{f.a}</p></div>)}</section>{a.sources&&<section class="articleSources"><h2>Fuentes consultadas</h2><p>La información técnica y las recomendaciones de seguridad se contrastaron con estas fuentes:</p><ul>{a.sources.map(source=><li><a href={source.url} rel="noopener noreferrer">{source.label} ↗</a></li>)}</ul></section>}<aside><h2>{a.ctaTitle??'¿Necesitas revisar tu techo?'}</h2><p>{a.ctaText??'Techofix ofrece cotización gratuita en Coacalco, Tultitlán, Zumpango, Tultepec, Cuautitlán, Cuautitlán Izcalli y Tlalnepantla.'}</p><a class="button" href={`https://wa.me/526722671419?text=${encodeURIComponent(a.ctaMessage??'Hola Techofix, quiero una cotización gratuita')}`}>Enviar fotos por WhatsApp ↗</a></aside></div></article></main>
</BaseLayout>
