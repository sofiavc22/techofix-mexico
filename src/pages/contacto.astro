---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const wa='https://wa.me/526722671419?text=Hola%20Techofix%2C%20quiero%20una%20cotizaci%C3%B3n%20gratuita';
---
<BaseLayout title="Contacto y cotización gratuita | Techofix" description="Solicita una cotización gratuita para reparar o impermeabilizar tu techo. Emergencias 24 horas: 672 267 1419.">
  <Header />
  <main>
    <section class="contactHero"><div><p class="eyebrow"><span></span>Cotización gratuita</p><h1>Hablemos de tu techo.</h1><p>Envíanos fotografías por WhatsApp o llámanos. Atendemos hogares, comercios y naves industriales.</p></div><aside><span>Atención directa</span><a href="tel:+526722671419">672 267 1419</a><a class="button" href={wa}>Abrir WhatsApp ↗</a></aside></section>
    <section class="section contactGrid"><article><span>01</span><h2>WhatsApp</h2><p>Envíanos fotografías, ubicación aproximada y una descripción del problema.</p><a href={wa}>Iniciar conversación ↗</a></article><article><span>02</span><h2>Teléfono</h2><p>Para emergencias o atención directa, llama las 24 horas.</p><a href="tel:+526722671419">Llamar ahora ↗</a></article><article><span>03</span><h2>Cobertura</h2><p>Coacalco, Tultitlán, Zumpango, Tultepec, Cuautitlán, Cuautitlán Izcalli y Tlalnepantla.</p><a href="/zonas/">Ver todas las zonas ↗</a></article></section>
    <section class="section contactInfo"><div><p class="sectionTag">Antes de cotizar</p><h2>¿Qué información necesitamos?</h2></div><ul><li>Tipo de inmueble: casa, comercio o nave industrial.</li><li>Municipio o zona donde se encuentra.</li><li>Tipo de techo, si lo conoces.</li><li>Fotografías del área afectada y de la cubierta.</li><li>Si existe una filtración activa o una emergencia.</li></ul></section>
  </main>
  <Footer />
</BaseLayout>
