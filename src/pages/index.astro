---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const wa='https://wa.me/525591069566?text=Hola%20Techofix%2C%20quiero%20una%20cotizaci%C3%B3n%20gratuita';
const businessSchema={"@context":"https://schema.org","@type":"RoofingContractor",name:"Techofix",url:"https://techofixmexico.site",telephone:"+52 55 9106 9566",description:"Reparación, instalación e impermeabilización de techos residenciales e industriales.",openingHours:"Mo-Su 00:00-23:59",paymentAccepted:"Efectivo, tarjeta y transferencia",areaServed:["Coacalco de Berriozábal","Tultitlán","Cuautitlán","Cuautitlán Izcalli"],priceRange:"$$"};
---
<BaseLayout title="Techofix | Reparación e instalación de techos" description="Reparación, instalación e impermeabilización de techos residenciales e industriales en Coacalco, Tultitlán, Cuautitlán y Cuautitlán Izcalli." schema={businessSchema}>
  <main><Header />
    <section class="hero" id="inicio"><div class="heroShade"></div><div class="heroContent"><p class="eyebrow"><span></span> Techos residenciales e industriales</p><h1>Soluciones firmes<br/>para cada techo.</h1><p class="heroText">Reparamos, instalamos y renovamos todo tipo de techos en Coacalco, Tultitlán, Cuautitlán y Cuautitlán Izcalli.</p><div class="heroActions"><a class="button" href={wa}>Solicitar cotización <b>↗</b></a><a class="textLink" href="tel:+525591069566">Llamar ahora <span>→</span></a></div></div><div class="heroStats"><div><i>01</i><strong>16</strong><span>Años de experiencia</span></div><div><i>02</i><strong>24/7</strong><span>Atención a emergencias</span></div><div><i>03</i><strong>Gratis</strong><span>Revisión y cotización</span></div></div></section>
    <section class="intro section"><div><p class="sectionTag">Protección que empieza desde arriba</p><h2>No cubrimos el problema.<br/><em>Reparamos su origen.</em></h2></div><div class="introCopy"><p>Una gotera puede venir de una grieta, una unión abierta, una pendiente incorrecta o una cubierta deteriorada. Primero revisamos el techo y después recomendamos la solución adecuada.</p><a href={wa}>Solicitar revisión gratuita <span>↗</span></a></div></section>
    <section class="services section" id="servicios"><div class="sectionHead"><div><p class="sectionTag light">Nuestros servicios</p><h2>Un especialista para<br/>cada tipo de techo.</h2></div><p>Atendemos desde una filtración localizada hasta la renovación completa de una nave industrial.</p></div><div class="serviceGrid"><article class="serviceCard featured"><span>01</span><div class="serviceIcon">⌂</div><h3>Reparación de techos</h3><p>Diagnóstico y solución de goteras, filtraciones, grietas, juntas y daños en la cubierta.</p><a href="/reparacion-de-techos/">Conocer el servicio ↗</a></article><article class="serviceCard"><span>02</span><div class="serviceIcon">▰</div><h3>Techos industriales</h3><p>Mantenimiento, reparación y cambio de láminas, canalones, traslapes y remates.</p><a href="/servicios/mantenimiento-de-techos-industriales/">Conocer el servicio ↗</a></article><article class="serviceCard"><span>03</span><div class="serviceIcon">◩</div><h3>Instalación y cambio</h3><p>Instalación de cubiertas nuevas y reemplazo parcial o completo para hogares y empresas.</p><a href="/servicios/instalacion-y-cambio-de-techos/">Conocer el servicio ↗</a></article><article class="serviceCard"><span>04</span><div class="serviceIcon">◆</div><h3>Impermeabilización</h3><p>Sistemas seleccionados según la superficie, exposición y condiciones reales del inmueble.</p><a href="/servicios/impermeabilizacion-de-techos/">Conocer el servicio ↗</a></article></div></section>
    <section class="split section" id="proceso"><div class="splitVisual"><div class="experience"><strong>16</strong><span>años resolviendo<br/>problemas de techos</span></div></div><div class="splitContent"><p class="sectionTag">Cómo trabajamos</p><h2>Una solución clara,<br/>antes de comenzar.</h2><p>Revisamos el estado real del techo, documentamos los puntos críticos y te explicamos qué necesita reparación y por qué.</p><ol><li><span>01</span><div><b>Cuéntanos el problema</b><p>Envíanos fotos o solicita una visita por WhatsApp.</p></div></li><li><span>02</span><div><b>Revisión y cotización gratuita</b><p>Evaluamos el daño y presentamos una propuesta clara.</p></div></li><li><span>03</span><div><b>Reparamos y respaldamos</b><p>Ejecutamos el trabajo y entregamos garantía por escrito.</p></div></li></ol></div></section>
    <section class="areas section" id="zonas"><div class="sectionHead darkText"><div><p class="sectionTag">Cobertura local</p><h2>Estamos cerca cuando<br/>tu techo lo necesita.</h2></div><p>Servicio residencial, comercial e industrial con atención de emergencias las 24 horas.</p></div><div class="areaList"><a href="/zonas/coacalco/"><span>01</span><strong>Coacalco</strong><b>↗</b></a><a href="/zonas/tultitlan/"><span>02</span><strong>Tultitlán</strong><b>↗</b></a><a href="/zonas/cuautitlan/"><span>03</span><strong>Cuautitlán</strong><b>↗</b></a><a href="/zonas/cuautitlan-izcalli/"><span>04</span><strong>Cuautitlán Izcalli</strong><b>↗</b></a></div></section>
    <section class="homeBlog section"><div class="sectionHead darkText"><div><p class="sectionTag">Guías Techofix</p><h2>Antes de reparar,<br/>entiende el problema.</h2></div><a href="/blog/">Ver todas las guías ↗</a></div><div class="homeBlogGrid"><a href="/blog/por-que-sigue-goteando-despues-de-impermeabilizar/"><span>Goteras y filtraciones</span><h3>¿Por qué sigue goteando después de impermeabilizar?</h3><b>Leer guía ↗</b></a><a href="/blog/mantenimiento-preventivo-techo-nave-industrial/"><span>Techos industriales</span><h3>Mantenimiento preventivo para una nave industrial</h3><b>Leer guía ↗</b></a><a href="/blog/reparar-o-impermeabilizar-techo/"><span>Guía para propietarios</span><h3>¿Tu techo necesita reparación o impermeabilización?</h3><b>Leer guía ↗</b></a></div></section>
    <section class="cta" id="contacto"><p class="sectionTag light">¿Tu techo necesita atención?</p><h2>Revisamos el problema.<br/>La cotización es gratuita.</h2><div><a class="button buttonWhite" href={wa}>Escribir por WhatsApp ↗</a><a class="phone" href="tel:+525591069566">55 9106 9566</a></div></section>
    <Footer />
  </main>
</BaseLayout>
